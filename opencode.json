{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push --force-with-lease*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git checkout -- *": "ask",
      "git restore*": "ask",
      "git branch -D*": "deny",
      "git rebase*": "ask",
      "git commit --amend*": "ask",
      "rm -rf*": "deny",
      "rm -r*": "ask",
      "docker compose down -v*": "deny",
      "psql*DROP*": "deny",
      "kubectl delete*": "deny",
      "terraform destroy*": "deny",
      "terraform apply*": "ask",
      "helm uninstall*": "deny"
    }
  }
}
