# Binaries and build output
/bin/
/dist/
*.exe

# Local environment and secrets — never commit real credentials
.env
.env.*
!.env.example

# Recordings and local data
/recordings/
/data/

# Go
/vendor/
coverage.out
*.test

# Node / Next.js
node_modules/
web/.next/
web/out/
web/coverage/

# Editors / OS
.idea/
# The shared VS Code workspace config is committed (settings, task and
# debug definitions, extension recommendations); per-user state is not.
# The negations only work because the directory itself is not excluded.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp
.DS_Store

# Playwright
web/test-results/
web/playwright-report/
web/tsconfig.tsbuildinfo
