# Copy to .env for local development. NEVER commit real secrets.
# All values here are placeholders; the app reads the environment directly.

# Operating mode: MARKET_DATA | RECORD | REPLAY | BACKTEST | PAPER | SHADOW
# First-boot seed only (T-059): after platform settings v1 exists the
# mode is changed from the console (platform.mode) and this is ignored.
# REPLAY/BACKTEST/SHADOW seed the document as MARKET_DATA.
ARB_MODE=MARKET_DATA

ARB_HTTP_ADDR=:8080
# Prometheus exposition (:9109 when set; empty = no metrics server).
# ARB_METRICS_ADDR=:9109
# First-boot seed only; hot-editable afterward as platform.log_level.
ARB_LOG_LEVEL=info
# First-boot seed only; hot-editable afterward as platform.allowed_origin.
# ARB_ALLOWED_ORIGIN=http://localhost:3000

# PostgreSQL. POSTGRES_PASSWORD is REQUIRED by docker-compose.yml (there
# is no default: compose refuses to start without it) and the container
# is published on 127.0.0.1:5432 only. Generate: openssl rand -base64 24
POSTGRES_PASSWORD=
# DSN for arbd/tests started from the host against the compose database.
# Replace the placeholder with the same value as POSTGRES_PASSWORD.
ARB_DATABASE_URL=postgres://arb:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:5432/arb?sslmode=disable

# Raw market-data recordings directory
ARB_RECORDING_DIR=recordings

# REPLAY/BACKTEST: recording session id (required in those modes)
# ARB_REPLAY_SESSION=

# First-boot topology/paper seeds (superseded by platform settings v1
# once it exists — symbols and per-venue paper balances are edited in
# the console after that).
# ARB_SYMBOLS=BTCUSDT,ETHUSDT,ETHBTC,BTCUSDC,ETHUSDC,USDCUSDT
# ARB_STARTING_ASSETS=USDT,USDC
# ARB_PAPER_BALANCE=10000

# Deterministic simulation seed (0 = derive and log)
# ARB_SEED=42

# Telegram bot (optional; empty disables). Comma-separated allow-listed user IDs.
# The token is the env FALLBACK: a value written to the secrets vault
# (T-060) wins. The allowlist seeds platform settings v1 only.
# ARB_TELEGRAM_TOKEN=
# ARB_TELEGRAM_ALLOWLIST=

# AI advisor. ANTHROPIC_API_KEY is the env fallback behind the secrets
# vault; ARB_AI_PROVIDER (anthropic|fake) and ARB_AI_MODEL seed the
# ai.* settings section on first boot only.
# ANTHROPIC_API_KEY=
# ARB_AI_PROVIDER=
# ARB_AI_MODEL=claude-sonnet-5

# Paddle billing (T-083; optional — billing stays unconfigured without
# these). The API key and webhook secret are read from the environment
# only; never commit real values.
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_CLIENT_TOKEN=
# PADDLE_ENV=sandbox

# Secrets vault master key (T-060): standard base64 of exactly 32 random
# bytes, e.g. `head -c 32 /dev/urandom | base64`. Unset = vault disabled;
# env-provided secrets above still work. Never commit a real value.
# ARB_SECRET_KEY=            # generate with: make create-secret

# OpenTelemetry tracing (audit O11): set the endpoint to export
# stage-boundary spans over OTLP/gRPC — the deployed Tempo distributor
# listens on http://tempo-distributor.monitoring:4317. Unset = tracing
# disabled (noop, zero cost). OTEL_SERVICE_NAME defaults to "arbd".
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=

# First-boot admin bootstrap. These two seed the very first console
# login and are ignored once any user exists; they are never read again
# and never stored in the vault. Change the password from the console
# after the first login, then remove them here.
# The values below are placeholders — replace both before any
# non-local deployment. Passwords set from the console must be at least
# 12 characters.
ARB_ADMIN_EMAIL=admin@example.invalid
# At least 12 characters. The process refuses to boot with a shorter
# password or with the placeholder that used to ship here; the value
# seeds the first admin only and is ignored once any user exists.
ARB_ADMIN_PASSWORD=

# Operational tuning (env-only, no console surface by design):
# graceful-shutdown budget (default 15s) and the topology monitor's
# metadata re-check interval (default 1h; 0 disables — audit T8).
# ARB_SHUTDOWN_GRACE=15s
# ARB_METADATA_CHECK_INTERVAL=1h

# Stays env-only by design: ARB_DATABASE_URL, ARB_HTTP_ADDR,
# ARB_METRICS_ADDR, ARB_RECORDING_DIR, ARB_ADMIN_EMAIL/PASSWORD,
# ARB_SEED, ARB_SHUTDOWN_GRACE, ARB_METADATA_CHECK_INTERVAL.

# Reverse proxies whose X-Forwarded-For / X-Real-IP the API may trust when
# attributing a client address (login throttling, audit, risk acknowledgement),
# as comma-separated CIDRs or addresses. Empty: the TCP peer is the client.
# Only set this for the proxy in front of the API; a wrong entry lets any
# client choose its own address.
ARB_TRUSTED_PROXIES=

# Console container only (deploy/docker/web.Dockerfile): the arbd API the
# Next.js server proxies /api to. Not read by arbd itself.
# ARB_BACKEND_URL=http://localhost:8080
