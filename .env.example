# Copy to .env for local development. NEVER commit real secrets.
# All values here are placeholders; the app reads the environment directly.

# Operating mode: MARKET_DATA | RECORD | REPLAY | BACKTEST | PAPER | SHADOW
# First-boot seed only (T-059): after platform settings v1 exists the
# mode is changed from the console (platform.mode) and this is ignored.
# REPLAY/BACKTEST/SHADOW seed the document as MARKET_DATA.
ARB_MODE=MARKET_DATA

ARB_HTTP_ADDR=:8080
# First-boot seed only; hot-editable afterward as platform.log_level.
ARB_LOG_LEVEL=info
# First-boot seed only; hot-editable afterward as platform.allowed_origin.
# ARB_ALLOWED_ORIGIN=http://localhost:3000

# PostgreSQL (docker-compose default)
ARB_DATABASE_URL=postgres://arb:arb-dev-password@localhost:5432/arb?sslmode=disable

# Raw market-data recordings directory
ARB_RECORDING_DIR=recordings

# REPLAY/BACKTEST: recording session id (required in those modes)
# ARB_REPLAY_SESSION=

# Deterministic simulation seed (0 = derive and log)
# ARB_SEED=42

# Telegram bot (optional; empty disables). Comma-separated allow-listed user IDs.
# The token is the env FALLBACK: a value written to the secrets vault
# (T-060) wins. The allowlist seeds platform settings v1 only.
# ARB_TELEGRAM_TOKEN=
# ARB_TELEGRAM_ALLOWLIST=

# AI advisor. ANTHROPIC_API_KEY is the env fallback behind the secrets
# vault; ARB_AI_PROVIDER (anthropic|fake) and ARB_AI_MODEL seed the
# ai.* settings section on first boot only.
# ANTHROPIC_API_KEY=
# ARB_AI_PROVIDER=
# ARB_AI_MODEL=claude-sonnet-5

# Secrets vault master key (T-060): standard base64 of exactly 32 random
# bytes, e.g. `head -c 32 /dev/urandom | base64`. Unset = vault disabled;
# env-provided secrets above still work. Never commit a real value.
# ARB_SECRET_KEY=            # generate with: make create-secret

# Stays env-only by design: ARB_DATABASE_URL, ARB_HTTP_ADDR,
# ARB_METRICS_ADDR, ARB_RECORDING_DIR, ARB_ADMIN_EMAIL/PASSWORD,
# ARB_SEED, ARB_SHUTDOWN_GRACE.
