# Copy to .env for local development. NEVER commit real secrets.
# All values here are placeholders; the app reads the environment directly.

# Operating mode: MARKET_DATA | RECORD | REPLAY | BACKTEST | PAPER | SHADOW
ARB_MODE=MARKET_DATA

ARB_HTTP_ADDR=:8080
ARB_LOG_LEVEL=info

# PostgreSQL (docker-compose default)
ARB_DATABASE_URL=postgres://arb:arb-dev-password@localhost:5432/arb?sslmode=disable

# Raw market-data recordings directory
ARB_RECORDING_DIR=recordings

# REPLAY/BACKTEST: recording session id (required in those modes)
# ARB_REPLAY_SESSION=

# Deterministic simulation seed (0 = derive and log)
# ARB_SEED=42

# Telegram bot (optional; empty disables). Comma-separated allow-listed user IDs.
# ARB_TELEGRAM_TOKEN=
# ARB_TELEGRAM_ALLOWLIST=

# AI advisor (optional; empty disables)
# ANTHROPIC_API_KEY=
# ARB_AI_MODEL=claude-sonnet-5
