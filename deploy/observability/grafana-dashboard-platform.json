{
  "title": "arb platform \u2014 SRE",
  "uid": "arb-platform-sre",
  "schemaVersion": 39,
  "tags": [
    "arbd",
    "sre"
  ],
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(market_messages_total, environment)",
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Feed health",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Market messages /s",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (exchange) (rate(market_messages_total{environment=~\"$environment\"}[1m]))",
          "legendFormat": "{{exchange}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Max book age (ms) \u2014 stale > 30 000",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (exchange) (orderbook_age_ms{environment=~\"$environment\"})",
          "legendFormat": "{{exchange}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Books not HEALTHY",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (exchange) (orderbook_state{environment=~\"$environment\"} != 1) or vector(0)",
          "legendFormat": "{{exchange}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Reconnects / gaps / resyncs (5m)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (exchange) (increase(exchange_reconnects_total{environment=~\"$environment\"}[5m]))",
          "legendFormat": "reconnects {{exchange}}"
        },
        {
          "refId": "B",
          "expr": "sum by (exchange) (increase(orderbook_sequence_errors_total{environment=~\"$environment\"}[5m]))",
          "legendFormat": "gaps {{exchange}}"
        },
        {
          "refId": "C",
          "expr": "sum by (exchange) (increase(orderbook_resync_total{environment=~\"$environment\"}[5m]))",
          "legendFormat": "resyncs {{exchange}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Feed freshness SLO (1h, target 0.995)",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:feed_fresh_ratio:rate1h",
          "legendFormat": "fresh ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Collectors: rate limits",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "429 / rate-limited responses (10m) \u2014 pending exporter series",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (exchange) (increase(exchange_rate_limited_total{environment=~\"$environment\"}[10m]))",
          "legendFormat": "{{exchange}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Rate-limited /s (15m)",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (exchange) (rate(exchange_rate_limited_total{environment=~\"$environment\"}[15m]))",
          "legendFormat": "{{exchange}}"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Recorder",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Frames written /s",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(recorder_frames_written_total{environment=~\"$environment\"}[1m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Frames dropped (5m)",
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (increase(recorder_frames_dropped_total{environment=~\"$environment\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Recordings PVC free",
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kubelet_volume_stats_available_bytes{namespace=\"arb\", persistentvolumeclaim=~\".*-recordings\"} / kubelet_volume_stats_capacity_bytes",
          "legendFormat": "{{persistentvolumeclaim}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Campaign runs",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Campaign runs by status (24h) \u2014 pending exporter series",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(campaign_runs_total{environment=~\"$environment\"}[24h]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Paper cycles success/failed (30m)",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(paper_cycles_success_total{environment=~\"$environment\"}[30m]))",
          "legendFormat": "success"
        },
        {
          "refId": "B",
          "expr": "sum(increase(paper_cycles_failed_total{environment=~\"$environment\"}[30m]))",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 104,
      "type": "row",
      "title": "API",
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "API p50 / p99 latency",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(api_request_duration_bucket{environment=~\"$environment\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(api_request_duration_bucket{environment=~\"$environment\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "API requests /s by status",
      "gridPos": {
        "x": 8,
        "y": 40,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(api_request_duration_count{environment=~\"$environment\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "API error ratio (SLO 0.1%)",
      "gridPos": {
        "x": 16,
        "y": 40,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:api_error_ratio:rate5m",
          "legendFormat": "5m"
        },
        {
          "refId": "B",
          "expr": "slo:api_error_ratio:rate1h",
          "legendFormat": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 105,
      "type": "row",
      "title": "Platform",
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Pod restarts (30m)",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"arb\"}[30m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Postgres replication lag (s)",
      "gridPos": {
        "x": 8,
        "y": 48,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_replication_lag_seconds",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Backup / restore drill age",
      "gridPos": {
        "x": 16,
        "y": 48,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - pg_backup_last_success_timestamp",
          "legendFormat": "last backup"
        },
        {
          "refId": "B",
          "expr": "time() - pg_restore_drill_timestamp",
          "legendFormat": "last drill"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    }
  ]
}